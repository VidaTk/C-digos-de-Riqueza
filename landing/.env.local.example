# URL del Google Apps Script Web App que recibe los registros
# (ver README.md, sección "Configurar Google Apps Script", para crearlo)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXXX/exec

# ID del Meta Pixel (Facebook/Instagram Ads)
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# URL base pública del sitio (usada para Open Graph y canonical)
NEXT_PUBLIC_SITE_URL=https://www.yosoyliderprofesional.com
