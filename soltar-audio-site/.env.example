# Contraseña compartida para entrar al sitio.
SITE_PASSWORD=SoltarSep21

# Secretos para firmar la cookie de sesión y las URLs temporales de audio.
# Genera valores únicos y largos, por ejemplo con: openssl rand -hex 32
SESSION_SECRET=
STREAM_SECRET=

# Se genera automáticamente al conectar un Blob store al proyecto en Vercel
# (Storage → Create Database → Blob). Para desarrollo local o para correr
# scripts/upload-audio.ts, cópialo desde la pestaña ".env.local" del store.
BLOB_READ_WRITE_TOKEN=
