# Base de datos (Postgres - recomendado: Neon o Supabase para hosting serverless con Vercel)
DATABASE_URL="postgresql://user:password@localhost:5432/codigos_riqueza?schema=public"

# Auth
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# App
PORT=4000
APP_BASE_URL="https://codigos.riqueza.app"
CORS_ORIGIN="http://localhost:5173"

# Membresia
MEMBERSHIP_MONTHLY_PRICE_MXN=99

# Stripe (Dashboard > Developers > API keys / Webhooks). Sin estas dos variables
# el servidor arranca igual, pero /payments/stripe/* responde 503.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
